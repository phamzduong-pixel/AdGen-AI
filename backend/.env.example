# Generate a long random value for production. Never commit the real value.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./chatbot.db
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_PROVIDER=gemini
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional STT foundation. This checkpoint fails closed unless a real provider
# adapter, dependency and credential mechanism are explicitly configured.
STT_PROVIDER=vosk
VOSK_MODEL_PATH=
STT_DEFAULT_LANGUAGE=vi-VN
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
STT_AUDIO_MAX_SIZE=10485760
STT_AUDIO_MAX_DURATION_SECONDS=300
STT_PROVIDER_TIMEOUT_SECONDS=600
# Optional Voice Conversion foundation. The provider remains fail-closed until
# a real adapter and capability validation are approved.
VC_PROVIDER=disabled
VC_MODEL=
VC_PROVIDER_TIMEOUT_SECONDS=120
VC_AUDIO_MAX_SIZE_BYTES=10485760
VC_AUDIO_MAX_DURATION_SECONDS=300
VC_AUDIO_PROBE_TIMEOUT_SECONDS=5
VC_OUTPUT_MAX_SIZE_BYTES=52428800
VC_PERSIST_OUTPUT=false
# Seed-VC runs in its own Python 3.10 CPU environment. CUDA is disabled by adapter.
SEED_VC_PYTHON=
SEED_VC_DIR=
SEED_VC_DIFFUSION_STEPS=20

# Optional local reference-voice TTS. Keep the SDK/model outside the repository.
# On Windows the defaults point to %LOCALAPPDATA%/AdGenAI/experiments/vieneu-tts.
VIENEU_PYTHON=
VIENEU_CACHE_DIR=
VIENEU_PROVIDER_TIMEOUT_SECONDS=900
VIENEU_REFERENCE_MAX_SIZE_BYTES=10485760
VIENEU_REFERENCE_MAX_DURATION_SECONDS=60
VIENEU_OUTPUT_MAX_SIZE_BYTES=52428800
# Optional. Enables Google Identity Services when also configured in frontend.
GOOGLE_CLIENT_ID=
# Optional. Enables the CP-2 Brave Web Search adapter when retrieval is requested.
BRAVE_SEARCH_API_KEY=replace_with_your_brave_search_api_key
EXTERNAL_RETRIEVAL_TIMEOUT_SECONDS=8
EXTERNAL_RETRIEVAL_MAX_RESULTS=5
EXTERNAL_RETRIEVAL_MAX_EXCERPT_CHARS=1000
EXTERNAL_RETRIEVAL_MAX_RETRIES=1


# Gmail SMTP (use a Google App Password, never your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=AdGen AI
SMTP_USE_TLS=true

PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_EMAIL_HOURLY_LIMIT=5
PASSWORD_RESET_IP_HOURLY_LIMIT=20

EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Comma-separated browser origins. Do not use * with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relative to the backend working directory or an absolute path.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
# Technical video editing (FFmpeg/FFprobe must be installed in the runtime).
MAX_VIDEO_SIZE=52428800
VIDEO_PROBE_TIMEOUT_SECONDS=5
VIDEO_AUDIO_EXTRACTION_TIMEOUT_SECONDS=60
MAX_VIDEO_DURATION_SECONDS=300
FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY is used by video processing and Voice Conversion audio validation.
FFPROBE_BINARY=ffprobe
VIDEO_PROCESS_TIMEOUT_SECONDS=120

# Database preparation bootstraps only a genuinely empty database; existing mismatches fail closed.
# development, test, or production
ENVIRONMENT=development
PORT=8000

# AI video generation uses the configured provider; real access/quota must be verified at runtime.
VIDEO_GENERATION_PROVIDER=gemini
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
MAX_VIDEO_GENERATION_DURATION_SECONDS=8
