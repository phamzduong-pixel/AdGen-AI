# Docker Compose configuration. Copy to .env and replace every placeholder.
POSTGRES_DB=adgen
POSTGRES_USER=adgen
POSTGRES_PASSWORD=replace_with_a_database_password

SECRET_KEY=replace_with_at_least_32_random_characters
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_GENERATION_TIMEOUT_SECONDS=120
GOOGLE_CLIENT_ID=
# Optional. Enables the CP-2 Brave Web Search adapter when retrieval is requested.
BRAVE_SEARCH_API_KEY=replace_with_your_brave_search_api_key
EXTERNAL_RETRIEVAL_TIMEOUT_SECONDS=8
EXTERNAL_RETRIEVAL_MAX_RESULTS=5
EXTERNAL_RETRIEVAL_MAX_EXCERPT_CHARS=1000
EXTERNAL_RETRIEVAL_MAX_RETRIES=1


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=AdGen AI
SMTP_USE_TLS=true
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_EMAIL_HOURLY_LIMIT=5
PASSWORD_RESET_IP_HOURLY_LIMIT=20
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE=10485760
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
